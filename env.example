# Database Configuration
DATABASE_URL=postgresql://postgres:admin@db:5432/ai_tcbs

# PostgreSQL Database
POSTGRES_DB=ai_tcbs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here

# Confluence Configuration
CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_USERNAME=your_confluence_username
CONFLUENCE_API_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE_KEYS=API,DOC
CONFLUENCE_MAX_RESULTS=50
CONFLUENCE_EXPAND_CONTENT=true

# Jira Configuration
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_USERNAME=your_jira_username
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEYS=QUIZ,USER,API
JIRA_MAX_RESULTS=50
JIRA_EXPAND_FIELDS=summary,description,comment
JIRA_GIT_REPOS=your-repo-name
JIRA_USE_BITBUCKET=true

# Bitbucket Configuration
BITBUCKET_USERNAME=your_bitbucket_username
BITBUCKET_WORKSPACE=your_workspace
BITBUCKET_APP_PASSWORD=your_bitbucket_app_password
BITBUCKET_BASE_URL=https://api.bitbucket.org
BITBUCKET_REPOSITORIES=your-repo-name
BITBUCKET_MAX_RESULTS=50

# Application Configuration
ENVIRONMENT=production
PYTHONPATH=/app/src 